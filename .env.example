# Copy this file to .env and fill in real values. Never commit .env itself.

# Groq is used first if this is set; otherwise the app falls back to local Ollama.
GROQ_API_KEY=

# Shared secret required in the X-API-Key header on every endpoint except /health.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PORTAL_API_KEY=

# Comma-separated list of origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:8501
